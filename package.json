    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "esbuild": "^0.24.2",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@surrealdb/wasm": "^3.0.3",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "surrealdb": "^2.0.8"
  },
  "packageManager": "pnpm@10.14.0"
