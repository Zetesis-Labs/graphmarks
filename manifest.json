{
  "manifest_version": 3,
  "name": "GraphMarks — Marcadores en grafo",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Nueva pestaña que muestra tus marcadores como un grafo interactivo, al estilo del graph view de Quartz.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "gm"
  },
  "permissions": ["bookmarks", "favicon", "tabs", "storage", "history"]
}
